# Copie este arquivo para .env e preencha somente as chaves que for utilizar.
# Nunca envie o arquivo .env para o Git.

GOODWE_PROVIDER=openai
GOODWE_TEMPERATURE=0.2
GOODWE_MAX_TOKENS=500

OPENAI_API_KEY=
GOODWE_OPENAI_MODEL=gpt-4o-mini

# Comparação recomendada com uma única chave OpenAI:
# goodwe-eval --providers legacy openai --openai-models gpt-4o-mini gpt-5-nano

# Gemini permanece opcional para quem quiser comparar provedores diferentes.
GEMINI_API_KEY=
GOODWE_GEMINI_MODEL=gemini-2.5-flash

